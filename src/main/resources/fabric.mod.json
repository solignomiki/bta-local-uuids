{
  "schemaVersion": 1,
  "id": "localuuids",
  "version": "${version}",

  "name": "Local UUIDs",
  "description": "Makes BTA store and use local uuids instead of Microsoft ones",
  "authors": [
    "solignomiki"
  ],
  "contact": {
    "homepage": "",
    "sources": ""
  },

	"icon": "icon.gif",
  "license": "CC0-1.0",

  "environment": "*",
  "entrypoints": {
    "main": [
			"solignomiki.localuuids.LocalUUIDs"
    ],
		"beforeGameStart": [
			"solignomiki.localuuids.LocalUUIDs"
		],
		"afterGameStart": [
			"solignomiki.localuuids.LocalUUIDs"
		],
		"recipesReady": [
			"solignomiki.localuuids.LocalUUIDs"
		]
	},
  "mixins": [
      "localuuids.mixins.json"
  ],

  "depends": {
		"minecraft": "*",
    "fabricloader": ">=${fabricloader}",
		"java": ">=${java}"
  },
  "suggests": {
		"modmenu": ">=${modmenu}"
  }
}
